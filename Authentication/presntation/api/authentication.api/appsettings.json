{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "myconn": "server=MSI\\POUYAN; database=authDb;TrustServerCertificate=True;Trusted_Connection=True;MultipleActiveResultSets=true;"
  },
  "appSetting": {
    // The signing key ("Token") is NOT stored here. Set it per machine:
    //   dotnet user-secrets set "appSetting:Token" "<random 64+ characters>"
    // or the environment variable appSetting__Token. The webapi must use the same value.
    "Issuer": "industrial-office-auth",
    "Audience": "industrial-office",
    "TokenLifetimeHours": 8
  },
  "BootstrapAdmin": {
    // When no user has the Admin role, the account with this email is given Admin at startup
    // (and created if BootstrapAdmin:Password is set — put the password in user-secrets, not here).
    "Email": ""
  }
}
